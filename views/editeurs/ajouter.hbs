<h1 class="titre">Ajouter un éditeur</h1>

<form class="formCreerEditeur" action="/publishers" method="POST" enctype="multipart/form-data">
  <div>
    <input class="titreModifierEditeur" type="text" name="name" placeholder="Nom de l’éditeur" required>
  </div>
  <label fichier> </label>
    <input class="dragAndDrop" accept = ".png, .gif, .jpeg" type="file" name="image"></input>
  <nav class="boutonAnnulerEnregistrer">
    <button class="enregistrer" type="submit">Créer l’éditeur</button>
  </nav>
</form>